          xmlns:conf="urn:mace:shibboleth:3.0:native:sp:config"
          xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
          clockSkew="180">
    -->
<SPConfig xmlns="urn:mace:shibboleth:3.0:native:sp:config"
          xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
          xmlns:clock="urn:mace:shibboleth:global:3.0:native:sp:config"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="urn:mace:shibboleth:3.0:native:sp:config shibboleth-3.0-native-sp-config.xsd"
          clockSkew="180">

    <RequestMapper type="Native">
    <RequestMap>
        <Host name="sp.shibboleth.ghsamlstack.localhost" scheme="https" port="443">
            <Path name="shib-protected"
                  authType="shibboleth"
                  requireSession="true"/> <!-- requireSessionWith="SAML2"/> -->
        </Host>
    </RequestMap>
</RequestMapper>

    <ApplicationDefaults id="default" policyId="default"
                         entityID="https://sprovider.secaas-labs-poc-01.org/sp/shibboleth"
                         REMOTE_USER="eppn uid persistent-id targeted-id">

        <Sessions lifetime="28800" timeout="3600" relayState="ss:mem"
                  checkAddress="false"
                  handlerSSL="false"
                  cookieProps="https"
                    handlerURL="https://sp.shibboleth.ghsamlstack.localhost/Shibboleth.sso">

            <SSO entityID="https://secaas-labs-poc-01.org/idp/shibboleth" ecp="true">
                SAML2
            </SSO>

            <!--
            <SSO entityID="https://secaas-labs-poc-01.org/idp/shibboleth" ecp="true" />

            <SessionInitiator type="SAML2" id="ecp_only"
                          binding="urn:oasis:names:tc:SAML:2.0:bindings:PAOS"
                          ForceAuthn="false" isPassive="false" />

            <Handler type="SAML2" Location="/SAML2/ECP" acsIndex="4" requiresSSL="false" acl="0.0.0.0/0 ::/0"/>
            -->
            <!-- SAML and local-only logout. -->
            <Logout>SAML2 Local</Logout>

            <!-- Extension service that generates "approximate" metadata based on SP configuration. -->
            <Handler type="MetadataGenerator" Location="/Metadata" signing="false"/>

            <!-- Status reporting service. -->
            <Handler type="Status" Location="/Status" acl="127.0.0.1 ::1"/>

            <!-- Session diagnostic service. -->
            <Handler type="Session" Location="/Session" showAttributeValues="true"/>

            <!-- JSON feed of discovery information. -->
            <Handler type="DiscoveryFeed" Location="/DiscoFeed"/>

        </Sessions>

        <!--<MetadataProvider type="XML" validate="true" path="idp-shibboleth-metadata.xml"/>-->
        <MetadataProvider type="XML" validate="false" path="idp-shibboleth-metadata.xml">
            <!-- Quitamos cualquier filtro de firma o vigencia temporal para desarrollo -->
        </MetadataProvider>
        <!-- Map to extract attributes from SAML assertions. -->
        <AttributeExtractor type="XML" validate="true" reloadChanges="false" path="attribute-map.xml"/>

        <!-- Use a SAML query if no attributes are supplied during SSO. -->
        <AttributeResolver type="Query" subjectMatch="true"/>

        <!-- Default filtering policy for recognized attributes, lets other data pass. -->
        <AttributeFilter type="XML" validate="true" path="attribute-policy.xml"/>

        <!-- Simple file-based resolver for using a single keypair. -->
        <CredentialResolver type="File" key="/run/secrets/sp_shibboleth_key"
                            certificate="/run/secrets/sp_shibboleth_cert"/>

    </ApplicationDefaults>

    <!-- Policies that determine how to process and authenticate runtime messages. -->
    <SecurityPolicyProvider type="XML" validate="true" path="security-policy.xml"/>

    <!-- Low-level configuration about protocols and bindings available for use. -->
    <ProtocolProvider type="XML" validate="true" reloadChanges="false" path="protocols.xml"/>

</SPConfig>